# EditorConfig - 编辑器配置
# 保障卡综合检查工具 v3.0.0

root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JavaScript 文件
[*.js]
indent_style = space
indent_size = 4
max_line_length = 120

# HTML 文件
[*.html]
indent_style = space
indent_size = 2
max_line_length = 120

# CSS 文件
[*.css]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

