        // ==================== 初始化 ====================
        /**
         * 初始化：将全局函数映射到规则对象
         */
        init: function() {
            var mappedCount = 0;
            var aliasCount = 0;
            
            for (var key in this.RULES) {
                if (this.RULES.hasOwnProperty(key)) {
                    // 填充函数引用
                    if (typeof window[key] === 'function') {
                        this.RULES[key].func = window[key];
                        mappedCount++;
                        
                        // 创建英文别名
                        var englishName = this.RULES[key].englishName;
                        if (englishName && !window[englishName]) {
                            window[englishName] = window[key];
                            aliasCount++;
                        }
                    }
                }
            }
            
            if (window.Logger) {
                window.Logger.log('RulesMapping 初始化完成: 映射了 ' + mappedCount + ' 个规则函数，创建了 ' + aliasCount + ' 个英文别名');
            }
        },
        
        // ==================== 获取规则函数 ====================
        /**
         * 获取规则函数（支持中英文名）
         * @param {string} name - 规则名称（拼音或英文）
         * @returns {Function|null} 规则函数
         */
        getRule: function(name) {
            if (!name) return null;
            
            // 直接查找（拼音名）
            if (this.RULES[name]) {
                return this.RULES[name].func;
            }
            
            // 按英文名查找
            for (var key in this.RULES) {
                if (this.RULES.hasOwnProperty(key)) {
                    if (this.RULES[key].englishName === name) {
                        return this.RULES[key].func;
                    }
                }
            }
            
            // 尝试从 window 直接获取
            if (typeof window[name] === 'function') {
                return window[name];
            }
            
            return null;
        },
        
        // ==================== 获取规则信息 ====================
        /**
         * 获取规则信息
         * @param {string} name - 规则名称
         * @returns {Object|null} 规则信息对象
         */
        getRuleInfo: function(name) {
            if (this.RULES[name]) {
                return this.RULES[name];
            }
            
            // 按英文名查找
            for (var key in this.RULES) {
                if (this.RULES.hasOwnProperty(key)) {
                    if (this.RULES[key].englishName === name) {
                        return this.RULES[key];
                    }
                }
            }
            
            return null;
        },
        
        // ==================== 按分类获取规则 ====================
        /**
         * 按分类获取规则列表
         * @param {string} category - 分类名称
         * @returns {Array} 规则信息数组
         */
        getRulesByCategory: function(category) {
            var rules = [];
            var ruleIds = this.CATEGORIES[category];
            
            if (!ruleIds) return rules;
            
            for (var i = 0; i < ruleIds.length; i++) {
                var ruleId = ruleIds[i];
                if (this.RULES[ruleId]) {
                    rules.push(this.RULES[ruleId]);
                }
            }
            
            return rules;
        },
        
        // ==================== 获取所有分类 ====================
        /**
         * 获取所有规则分类
         * @returns {Array} 分类名称数组
         */
        getAllCategories: function() {
            var categories = [];
            for (var category in this.CATEGORIES) {
                if (this.CATEGORIES.hasOwnProperty(category)) {
                    categories.push(category);
                }
            }
            return categories;
        },
        
        // ==================== 获取所有规则 ====================
        /**
         * 获取所有规则信息
