/* app.rc - 清单与版本信息(不依赖系统头文件,便于 windres 直接编译) */

/* RT_MANIFEST = 24 */
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x0000003fL
 FILEFLAGS       0x00000000L
 FILEOS          0x00040004L
 FILETYPE        0x00000001L
 FILESUBTYPE     0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "BaoZhangKa All-in-One Tool"
            VALUE "InternalName",     "BaoZhangKaTool"
            VALUE "OriginalFilename", "BaoZhangKaTool.exe"
            VALUE "ProductName",      "BaoZhangKa All-in-One Tool"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

